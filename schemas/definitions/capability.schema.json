{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-review-system.example/definitions/capability.schema.json",
  "title": "Capability (frontmatter của CAPABILITY.md)",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["asset_type", "id", "version", "status", "assessment_layer", "profiles", "phases", "output_contracts"],
  "properties": {
    "asset_type": { "const": "capability" },
    "id": { "$ref": "../common/common-defs.schema.json#/$defs/AssetId" },
    "version": { "$ref": "../common/common-defs.schema.json#/$defs/SemVer" },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "assessment_layer": { "enum": ["document-quality", "feasibility", "cross-layer"] },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "../common/common-defs.schema.json#/$defs/AssetId" } },
    "phases": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 10 } },
    "output_contracts": { "type": "array", "items": { "type": "string" } },
    "project_config_inputs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
