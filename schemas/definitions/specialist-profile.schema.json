{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-review-system.example/definitions/specialist-profile.schema.json",
  "title": "Specialist Profile (frontmatter)",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["asset_type", "id", "version", "status", "core_agent", "capability", "applies_to", "skills"],
  "properties": {
    "asset_type": { "const": "specialist-profile" },
    "id": { "$ref": "../common/common-defs.schema.json#/$defs/AssetId" },
    "version": { "$ref": "../common/common-defs.schema.json#/$defs/SemVer" },
    "status": { "enum": ["draft", "active", "deprecated"] },
    "core_agent": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "enum": ["artifact-reviewer", "cross-artifact-analyzer", "solution-assessor", "critic", "report-synthesizer"] },
        "version": { "$ref": "../common/common-defs.schema.json#/$defs/SemVerRange" }
      },
      "additionalProperties": false
    },
    "capability": { "$ref": "../common/common-defs.schema.json#/$defs/AssetId" },
    "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "version", "required"],
        "properties": {
          "skill_id": { "$ref": "../common/common-defs.schema.json#/$defs/SkillId" },
          "version": {
            "description": "null khi Skill đang planned",
            "oneOf": [ { "$ref": "../common/common-defs.schema.json#/$defs/SemVerRange" }, { "type": "null" } ]
          },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "context_fields": { "type": "array", "items": { "type": "string" } },
    "finding_categories": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
