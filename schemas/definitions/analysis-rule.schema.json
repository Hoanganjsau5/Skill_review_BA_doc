{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-review-system.example/definitions/analysis-rule.schema.json",
  "title": "Analysis / comparison rules file (rules.yaml của Skill hoặc consistency-rules.yaml của Capability)",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["owner", "rules"],
  "properties": {
    "owner": {
      "type": "object",
      "required": ["owner_type", "owner_id", "owner_version"],
      "properties": {
        "owner_type": { "enum": ["skill", "capability"] },
        "owner_id": { "type": "string" },
        "owner_version": { "$ref": "../common/common-defs.schema.json#/$defs/SemVer" }
      },
      "additionalProperties": false
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/Rule" } }
  },
  "$defs": {
    "Rule": {
      "type": "object",
      "required": ["rule_id", "rule_type", "statement", "inputs", "method", "rationale", "authority_level", "validation"],
      "properties": {
        "rule_id": { "$ref": "../common/common-defs.schema.json#/$defs/ItemId" },
        "rule_type": { "enum": ["analysis", "comparison"] },
        "statement": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "method": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "authority_level": { "enum": ["official-standard", "industry-best-practice", "expert-recommendation", "internal-convention"] },
        "source_refs": { "type": "array", "items": { "$ref": "../common/common-defs.schema.json#/$defs/SourceRef" } },
        "origin_note": { "type": ["string", "null"] },
        "validation": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["unvalidated", "validated"] },
            "examples": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "authority_level": { "const": "internal-convention" } } },
          "then": { "anyOf": [ { "required": ["origin_note"], "properties": { "origin_note": { "type": "string", "minLength": 1 } } }, { "required": ["source_refs"], "properties": { "source_refs": { "minItems": 1 } } } ] },
          "else": { "required": ["source_refs"], "properties": { "source_refs": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
