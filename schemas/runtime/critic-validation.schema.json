{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-review-system.example/runtime/critic-validation.schema.json",
  "title": "Critic Validation",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["validation_id", "target", "decision", "checks", "rationale", "producer"],
  "properties": {
    "validation_id": { "type": "string", "pattern": "^CV-[A-Za-z0-9-]+$" },
    "target": {
      "type": "object",
      "required": ["ref_type", "ref_id", "producer_assignment_id"],
      "properties": {
        "ref_type": { "enum": ["finding", "risk", "feasibility-assessment", "delivery-readiness"] },
        "ref_id": { "type": "string" },
        "producer_assignment_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "decision": { "enum": ["validated", "challenged", "rejected"] },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check", "result"],
        "properties": {
          "check": { "enum": ["evidence-quality", "logical-consistency", "unsupported-conclusion", "duplicate", "misinterpretation", "missing-assumption", "basis-validity"] },
          "result": { "enum": ["pass", "fail", "not-applicable"] },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "duplicate_of": { "type": "array", "items": { "type": "string" } },
    "missing_assumptions": { "type": "array", "items": { "type": "string" } },
    "suggested_action": { "type": "string" },
    "source_checked": { "type": "array", "items": { "$ref": "../common/common-defs.schema.json#/$defs/SourceRef" } },
    "producer": { "$ref": "../common/common-defs.schema.json#/$defs/ProducerRef" }
  },
  "additionalProperties": false
}
