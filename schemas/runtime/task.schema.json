{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-review-system.example/runtime/task.schema.json",
  "title": "Task",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["task_id", "run_id", "project_id", "created_at", "objective", "task_type", "capabilities", "scope"],
  "properties": {
    "task_id": { "type": "string" },
    "run_id": { "type": "string" },
    "project_id": { "type": "string" },
    "created_at": { "$ref": "../common/common-defs.schema.json#/$defs/IsoDateTime" },
    "requested_by": { "type": "string" },
    "original_request": { "type": "string", "description": "Yêu cầu nguyên văn của user" },
    "objective": { "type": "string", "description": "Objective đã được Orchestrator diễn giải" },
    "task_type": { "enum": ["document-review", "feasibility-assessment", "readiness-check", "full-assessment"] },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["document-quality", "feasibility-risk", "delivery-readiness"] }
    },
    "target_stage": { "type": ["string", "null"], "description": "Bắt buộc khi có delivery-readiness" },
    "scope": { "$ref": "../common/common-defs.schema.json#/$defs/Scope" },
    "workflow_profile": { "type": "string" },
    "enabled_phases": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 10 } },
    "user_constraints": { "type": "array", "items": { "type": "string" } },
    "clarifications_needed": { "type": "array", "items": { "$ref": "../common/common-defs.schema.json#/$defs/ClarificationRequest" } }
  },
  "allOf": [
    {
      "if": { "properties": { "capabilities": { "contains": { "const": "delivery-readiness" } } } },
      "then": { "required": ["target_stage"], "properties": { "target_stage": { "type": "string" } } }
    }
  ],
  "additionalProperties": false
}
