{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-review-system.example/runtime/risk.schema.json",
  "title": "Risk",
  "description": "Sự kiện bất định có thể ảnh hưởng tiêu cực. Likelihood/impact chỉ được gán khi dự án có risk-assessment-method; nếu không → not-assessed.",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["risk_id", "title", "description", "cause", "consequence", "likelihood", "impact", "risk_level", "evidence", "confidence", "producer"],
  "properties": {
    "risk_id": { "type": "string", "pattern": "^R-[A-Za-z0-9-]+$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "dimension": { "enum": ["requirement-feasibility", "technical-feasibility", "implementation-readiness", "external-dependencies", "project-constraints"] },
    "cause": { "type": "string" },
    "consequence": { "type": "string" },
    "likelihood": { "$ref": "#/$defs/RatedValue" },
    "impact": { "$ref": "#/$defs/RatedValue" },
    "risk_level": { "$ref": "#/$defs/RatedValue" },
    "related_assumptions": { "type": "array", "items": { "type": "string" } },
    "related_finding_ids": { "type": "array", "items": { "type": "string" } },
    "mitigation": { "type": "string" },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "../common/common-defs.schema.json#/$defs/Evidence" },
          { "$ref": "../common/common-defs.schema.json#/$defs/ExternalEvidence" }
        ]
      }
    },
    "owner": { "type": ["string", "null"] },
    "confidence": { "$ref": "../common/common-defs.schema.json#/$defs/Confidence" },
    "producer": { "$ref": "../common/common-defs.schema.json#/$defs/ProducerRef" }
  },
  "$defs": {
    "RatedValue": {
      "oneOf": [
        { "const": "not-assessed" },
        {
          "type": "object",
          "required": ["value", "method_ref"],
          "properties": {
            "value": { "type": "string", "description": "Giá trị thuộc thang định nghĩa trong risk-assessment-method.yaml" },
            "method_ref": { "type": "string", "description": "Đường dẫn + version/hash của risk-assessment-method.yaml" },
            "justification": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
